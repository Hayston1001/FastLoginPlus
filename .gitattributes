# Normalize every text file to LF, in the repository and in the working tree.
# `auto` leaves binaries to git's own detection, `eol=lf` overrides
# core.autocrlf — so extensionless files (gradlew, .gitignore) and any new
# file type are covered without a list to maintain.
* text=auto eol=lf

# Windows batch files: cmd.exe mis-parses LF-only labels/goto and if-blocks
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: kept explicit because `text=auto` detects these heuristically
*.jar binary
*.class binary
*.der binary
*.png binary
*.jpg binary
*.gif binary
