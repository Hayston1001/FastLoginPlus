<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.games647</groupId>
        <artifactId>fastloginplus</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fastloginplus.craftapi</artifactId>
    <packaging>jar</packaging>

    <!--
        Vendored CraftAPI, the Mojang API client FastLoginPlus talks to Mojang with.
        Package names are intentionally unchanged (com.github.games647.craftapi) so the
        four platform modules need no source changes; the copy is shaded from this module
        instead of the external com.github.games647:craftapi artifact.  It is pinned to the
        upstream tree the previously shipped craftapi-0.8.1.jar was built from (commit
        6f0ded9f, 2024-05-05, Java 8) plus local fixes to the name lookup: 403 fallback to
        Mojang's second endpoint, a working mojang-request-limit, and the proxy fallback
        sending the complete URL.  Do not bump Gson/Guava on their own - see the notes in
        the dependency block below.
    -->
    <name>FastLoginPlusCraftAPI</name>
    <description>
        Internal, vendored copy of CraftAPI (Mojang API client) - never deployed or published on its own
    </description>

    <properties>
        <!-- Same Java floor as the module that consumes it: bukkit must stay loadable on Java 8 -->
        <maven.compiler.release>8</maven.compiler.release>
        <!-- Internal reactor module - only ever shipped inside the four platform jars -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
            Versions are pinned to what the upstream craftapi 0.8.1 POM declared.  Do not bump
            them on their own: bukkit/folia shade and relocate Guava + Gson from here, and
            bungee/velocity exclude both on purpose (the proxy ships its own copy).
        -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>32.1.2-jre</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>com.github.games647.craftapi</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
