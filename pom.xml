<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.games647</groupId>
    <!--This has to be in lowercase because it's used by plugin.yml-->
    <artifactId>fastloginplus</artifactId>
    <packaging>pom</packaging>

    <name>FastLoginPlus</name>
    <version>${revision}</version>

    <url>https://github.com/Hayston1001/FastLoginPlus</url>
    <description>
        Actively maintained fork of FastLogin with updates and feature enhancements
    </description>

    <properties>
        <revision>0.7.0</revision>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Set default for non-git clones -->
        <maven.compiler.release>8</maven.compiler.release>

        <floodgate.version>2.2.5-SNAPSHOT</floodgate.version>
        <geyser.version>2.10.1-SNAPSHOT</geyser.version>
        <geyser-base-api.version>1.0.3</geyser-base-api.version>
        <fastutil.version>8.5.16</fastutil.version>
        <cumulus.version>1.1.2</cumulus.version>

        <!-- Shared across bukkit + folia -->
        <protocollib.version>5.3.0</protocollib.version>
        <protocolsupport.version>master-66b494a8dd-1</protocolsupport.version>
        <datafixerupper.version>7.1.15</datafixerupper.version>
        <netty.version>4.1.103.Final</netty.version>
        <placeholderapi.version>2.11.6</placeholderapi.version>
        <authme.version>5.6.0</authme.version>
        <loginsecurity.version>3.3.0</loginsecurity.version>
        <skinsrestorer.version>15.11.0</skinsrestorer.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <logit.version>9e3581db27</logit.version>
        <passky.version>v3.0.0</passky.version>
        <xauth.version>2.6</xauth.version>
        <crazycore.version>10.7.7</crazycore.version>
        <crazylogin.version>7.23</crazylogin.version>
        <ultraauth.version>2.0.2</ultraauth.version>

        <!-- Shared across bungee + velocity -->
        <sqlite.version>3.42.0.0</sqlite.version>
        <mariadb.version>3.5.10</mariadb.version>
    </properties>

    <modules>
        <module>craftapi</module>
        <module>core</module>
        <module>bukkit</module>
        <module>folia</module>
        <module>bungee</module>
        <module>velocity</module>
    </modules>

    <!--Deployment configuration for the Maven repository-->
    <distributionManagement>
        <snapshotRepository>
            <id>codemc-snapshots</id>
            <url>https://repo.codemc.io/repository/maven-snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
    </distributionManagement>

    <repositories>
        <!--
            OpenCollab's aggregate repository, and the only Geyser/Floodgate source: both publish
            nothing but -SNAPSHOT coordinates (it serves their regular releases too, such as
            base-api and cumulus).  Declared once, here, on purpose - Maven keys
            maven-metadata-<id>.xml and _remote.repositories on the id, so a module-level copy
            under the same id pointing elsewhere, or a second id for the same URL, makes it
            impossible to tell which repository a resolved snapshot build came from.
        -->
        <repository>
            <id>opencollab-main</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
    </repositories>

    <build>
        <!--Just use the project name to replace an old version of the plugin if the user does only copy-paste-->
        <finalName>${project.name}-${revision}-${git.commit.id.abbrev}</finalName>

        <plugins>
            <!--
                Guards the runtime floor each platform module promises (core/bukkit/craftapi 8,
                bungee/velocity 17, folia 21).  Compiling with release 8 links against newer bytecode
                without a warning, so a dependency bump can raise a floor silently and only fail on
                a user's JVM with UnsupportedClassVersionError.  maxJdkVersion is the module's own
                maven.compiler.release, so a module that raises it deliberately needs no second edit.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>extra-enforcer-rules</artifactId>
                        <version>1.9.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>enforce-dependency-bytecode</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <enforceBytecodeVersion>
                                    <maxJdkVersion>${maven.compiler.release}</maxJdkVersion>
                                    <ignoredScopes>
                                        <!-- Test jars (JUnit 5, Mockito) never reach a user. -->
                                        <ignoredScope>test</ignoredScope>
                                        <!-- Provided jars are the server's: Geyser/Floodgate target
                                             Java 17+ and only load when those plugins are present,
                                             and the BungeeCord proxy is the proxy's own business.
                                             What is left is what we actually shade in. -->
                                        <ignoredScope>provided</ignoredScope>
                                    </ignoredScopes>
                                </enforceBytecodeVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <!-- Update compiler plugin for old Maven versions like GH runner -->
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>

            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>4.5</version>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <multi>
                                <!-- Machine-readable representation -->
                                <preamble>SPDX-License-Identifier: MIT</preamble>
                                <header>LICENSE</header>
                            </multi>
                            <excludes>
                                <exclude>src/test/resources/**</exclude>
                                <exclude>src/main/resources/**</exclude>
                                <exclude>.java-version</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                </configuration>
                <executions>
                    <execution>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <linkXRef>false</linkXRef>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>14.1.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Require newer versions for Junit5 support -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- Work-around to make multi-release classes discoverable
                    https://issues.apache.org/jira/browse/SUREFIRE-1731 -->
                    <classesDirectory>
                        ${project.build.directory}/classes/META-INF/versions/21
                    </classesDirectory>
                    <additionalClasspathElements>
                        <additionalClasspathElement>
                            ${project.build.outputDirectory}
                        </additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <!-- Explicitly enable multi-release for the scheduler,
                because detection from class shading doesn't work -->
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <archive>
                                <manifestEntries>
                                    <Multi-Release>true</Multi-Release>
                                    <Implementation-Version>${revision}-${git.commit.id.abbrev}</Implementation-Version>
                                    <Implementation-Title>${project.name}</Implementation-Title>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Resolve ${revision} in published POMs -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>9.0.1</version>
                <executions>
                    <execution>
                        <id>git-info</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>
                        ${project.build.outputDirectory}/git.properties
                    </generateGitPropertiesFilename>
                    <shortCommitLength>7</shortCommitLength>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <!-- Certificate should not be filtered, as it would make it invalid -->
                <directory>src/main/resources</directory>
                <includes>
                    <include>yggdrasil_session_pubkey.der</include>
                </includes>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>yggdrasil_session_pubkey.der</exclude>
                </excludes>
                <!--Replace variables-->
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>

        <!-- Require inline to support static mocks -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.18.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
